[
  { "name": "arithmetic", "formula": "TAG(\"n\") + 1", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": 3.5 } ] },
  { "name": "division by zero has no value", "formula": "TAG(\"n\") / 0", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": null } ] },
  { "name": "unary minus", "formula": "-TAG(\"n\")", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": -2.5 } ] },

  { "name": "greater than", "formula": "TAG(\"n\") > 2", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": true }, { "values": { "n": 1 }, "want": false } ] },
  { "name": "equal on numbers", "formula": "TAG(\"n\") = 2.5", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": true } ] },

  { "name": "equal on strings", "formula": "TAG(\"s\") = \"open\"", "types": { "s": "string" },
    "steps": [ { "values": { "s": "open" }, "want": true }, { "values": { "s": "shut" }, "want": false } ] },
  { "name": "two strings compare in code point order", "formula": "TAG(\"s\") < \"z\"", "types": { "s": "string" },
    "steps": [ { "values": { "s": "open" }, "want": true } ] },
  { "name": "a string against a number reads its text", "formula": "TAG(\"s\") = 1", "types": { "s": "string" },
    "steps": [ { "values": { "s": "1" }, "want": true }, { "values": { "s": "open" }, "want": false } ] },

  { "name": "a boolean against 1 is the boolean", "formula": "TAG(\"b\") = 1", "types": { "b": "boolean" },
    "steps": [ { "values": { "b": true }, "want": true }, { "values": { "b": false }, "want": false } ] },
  { "name": "a boolean against 0 is the boolean", "formula": "TAG(\"b\") = 0", "types": { "b": "boolean" },
    "steps": [ { "values": { "b": false }, "want": true } ] },
  { "name": "a boolean against another number has no value", "formula": "TAG(\"b\") = 2", "types": { "b": "boolean" },
    "steps": [ { "values": { "b": true }, "want": false } ] },

  { "name": "and is false as soon as one side is", "formula": "AND(TAG(\"b\"), TAG(\"n\") > 9)", "types": { "b": "boolean", "n": "number" },
    "steps": [ { "values": { "b": true, "n": 1 }, "want": false } ] },
  { "name": "and of an unknown and a false is false", "formula": "AND(TAG(\"u\") > 1, TAG(\"n\") > 9)", "types": { "u": "number", "n": "number" },
    "steps": [ { "values": { "u": null, "n": 1 }, "want": false } ] },
  { "name": "and of an unknown and a true has no value", "formula": "AND(TAG(\"u\") > 1, TAG(\"n\") > 1)", "types": { "u": "number", "n": "number" },
    "steps": [ { "values": { "u": null, "n": 2 }, "want": null } ] },
  { "name": "or of an unknown and a true is true", "formula": "OR(TAG(\"u\") > 1, TAG(\"n\") > 1)", "types": { "u": "number", "n": "number" },
    "steps": [ { "values": { "u": null, "n": 2 }, "want": true } ] },
  { "name": "or of an unknown and a false has no value", "formula": "OR(TAG(\"u\") > 1, TAG(\"n\") > 9)", "types": { "u": "number", "n": "number" },
    "steps": [ { "values": { "u": null, "n": 1 }, "want": null } ] },
  { "name": "not of an unknown has no value", "formula": "NOT(TAG(\"u\") > 1)", "types": { "u": "number" },
    "steps": [ { "values": { "u": null }, "want": null } ] },

  { "name": "a comparison with no value has no value", "formula": "TAG(\"u\") > 1", "types": { "u": "number" },
    "steps": [ { "values": { "u": null }, "want": null } ] },

  { "name": "bitwise and", "formula": "BITAND(TAG(\"i\"), 4)", "types": { "i": "integer" },
    "steps": [ { "values": { "i": 12 }, "want": 4 } ] },
  { "name": "bitwise or", "formula": "BITOR(TAG(\"i\"), 1)", "types": { "i": "integer" },
    "steps": [ { "values": { "i": 12 }, "want": 13 } ] },
  { "name": "bitwise exclusive or", "formula": "BITXOR(TAG(\"i\"), 12)", "types": { "i": "integer" },
    "steps": [ { "values": { "i": 12 }, "want": 0 } ] },
  { "name": "hex to decimal", "formula": "HEX2DEC(\"FF\")", "types": {},
    "steps": [ { "values": {}, "want": 255 } ] },
  { "name": "a hex string that is not hex has no value", "formula": "HEX2DEC(\"zz\")", "types": {},
    "steps": [ { "values": {}, "want": null } ] },
  { "name": "a bit mask over a status word", "formula": "BITAND(TAG(\"i\"), HEX2DEC(\"10\")) != 0", "types": { "i": "integer" },
    "steps": [ { "values": { "i": 16 }, "want": true }, { "values": { "i": 12 }, "want": false } ] },

  { "name": "join renders a number", "formula": "\"n=\" & TAG(\"n\")", "types": { "n": "number" },
    "steps": [ { "values": { "n": 2.5 }, "want": "n=2.5" } ] },
  { "name": "join renders a whole number without a point", "formula": "\"n=\" & TAG(\"n\")", "types": { "n": "number" },
    "steps": [ { "values": { "n": 42 }, "want": "n=42" } ] },
  { "name": "join renders a boolean", "formula": "\"b=\" & TAG(\"b\")", "types": { "b": "boolean" },
    "steps": [ { "values": { "b": true }, "want": "b=true" } ] },
  { "name": "join of a value that is not known gives nothing", "formula": "\"x\" & TAG(\"u\")", "types": { "u": "number" },
    "steps": [ { "values": { "u": null }, "want": "x" } ] },

  { "name": "changed is false on the first value", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false } ] },
  { "name": "changed is false while the value holds", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": 1 }, "want": false } ] },
  { "name": "changed is true on a new value", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": 2 }, "want": true } ] },
  { "name": "changed on every new value, not only the first", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": 2 }, "want": true },
               { "values": { "n": 3 }, "want": true }, { "values": { "n": 3 }, "want": false } ] },
  { "name": "a value going unknown is not a change", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": null }, "want": false } ] },
  { "name": "the same value after an outage is not a change", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": null }, "want": false },
               { "values": { "n": 1 }, "want": false } ] },
  { "name": "a different value after an outage is a change", "formula": "CHANGED(TAG(\"n\"))", "types": { "n": "number" },
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": null }, "want": false },
               { "values": { "n": 2 }, "want": true } ] },

  { "name": "stale is false while the value moves", "formula": "STALE(TAG(\"n\"), 10min)", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": 2 }, "want": false } ] },
  { "name": "stale is true after the window without a change", "formula": "STALE(TAG(\"n\"), 5min)", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": 1 }, "want": false }, { "values": { "n": 1 }, "want": false },
               { "values": { "n": 1 }, "want": false }, { "values": { "n": 1 }, "want": false },
               { "values": { "n": 1 }, "want": false }, { "values": { "n": 1 }, "want": true } ] },
  { "name": "a value that is not known is stale at once", "formula": "STALE(TAG(\"n\"), 10min)", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": null }, "want": true } ] },

  { "name": "a rate needs two samples", "formula": "RATE(TAG(\"n\"), 10min)", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": 0 }, "want": null } ] },
  { "name": "a threshold on a rate that knows nothing does not fire", "formula": "RATE(TAG(\"n\"), 10min) < 5", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": 0 }, "want": null } ] },

  { "name": "an average with no sample has no value", "formula": "AVG(TAG(\"u\"), 10min)", "types": { "u": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "u": null }, "want": null } ] },
  { "name": "the average of a constant is the constant", "formula": "AVG(TAG(\"n\"), 5min)", "types": { "n": "number" }, "step_seconds": 60,
    "steps": [ { "values": { "n": 7 }, "want": 7 }, { "values": { "n": 7 }, "want": 7 }, { "values": { "n": 7 }, "want": 7 } ] }
]
